# GanaHeza Frontend — Environment Variables (template)
# Copy this file to .env and fill in your values.
# Expo SDK 54+ inlines EXPO_PUBLIC_* vars at bundle time.

# ── API base URL ──────────────────────────────────────────────────────────────
# - Android emulator:  http://10.0.2.2:3000
# - Real device (WiFi): http://<YOUR_PC_IP>:3000
# - Production:         https://your-hosted-domain.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ── Request timeout (milliseconds) ───────────────────────────────────────────
EXPO_PUBLIC_API_TIMEOUT=15000

# ── Storage Provider ──────────────────────────────────────────────────────────
# Must match STORAGE_PROVIDER in backend/.env.
# Used by the frontend to know whether uploaded image URLs are full CDN URLs
# (cloudinary) or relative paths that need the API base URL prepended (local).
# Options: local | cloudinary
EXPO_PUBLIC_STORAGE_PROVIDER=local
